# NOTES: 
# - Do not use double-quotes and do not delete any of the variables.
# - Make sure that NEXTAUTH_URL=http://localhost:3000 has no comments in the same line.

# Update your Azure OpenAI details
# AZURE_OPENAI_API_INSTANCE_NAME should be just the name of azure openai resource and not the full url; 
# AZURE_OPENAI_API_DEPLOYMENT_NAME should be deployment name from your azure openai studio and not the model name.
# AZURE_OPENAI_API_VERSION should be Supported versions checkout docs https://learn.microsoft.com/en-us/azure/ai-services/openai/reference
AZURE_OPENAI_API_KEY=111111
AZURE_OPENAI_API_INSTANCE_NAME=azurechat
AZURE_OPENAI_API_DEPLOYMENT_NAME=gpt-4
# Word文書の生成・編集・推敲に使うモデル。未設定時は AZURE_OPENAI_API_DEPLOYMENT_NAME にフォールバック。
AZURE_OPENAI_WORD_EDIT_DEPLOYMENT_NAME=
AZURE_OPENAI_PPT_DEPLOYMENT_NAME=gpt-5.6-terra
AZURE_OPENAI_API_VERSION=2023-12-01-preview
AZURE_OPENAI_API_EMBEDDINGS_DEPLOYMENT_NAME=embedding

# gpt-image-2 image generation endpoint config
AZURE_OPENAI_DALLE_API_KEY=222222
AZURE_OPENAI_DALLE_API_INSTANCE_NAME=azurechat-dall-e
AZURE_OPENAI_DALLE_API_DEPLOYMENT_NAME=gpt-image-2
AZURE_OPENAI_DALLE_API_VERSION=2025-04-01-preview
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview

# GPT4 V OpenaAI details
AZURE_OPENAI_VISION_API_KEY=333333
AZURE_OPENAI_VISION_API_INSTANCE_NAME=azurechat-vision
AZURE_OPENAI_VISION_API_DEPLOYMENT_NAME=gpt-4-vision
AZURE_OPENAI_PPT_VISION_DEPLOYMENT_NAME=gpt-5.6-terra
AZURE_OPENAI_VISION_API_VERSION=2023-12-01-preview

# Update your admin email addresses - comma separated
ADMIN_EMAIL_ADDRESS=you@email.com,you2@email.com

# Identity provider is optional if you are running in development mode locally (npm run dev)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Microsoft Teams bot (disabled by default).
# Leave TEAMS_BOT_* empty to reuse the corresponding AZURE_AD_* value.
TEAMS_ENABLED=false
TEAMS_BOT_ID=
TEAMS_BOT_SECRET=
TEAMS_TENANT_ID=
# Optional system prompt used only for Teams conversations.
TEAMS_SYSTEM_PROMPT=
# Local Playground only. Uses SL_LOCAL_DEFAULT_EMAIL when omitted.
TEAMS_TEST_USER_EMAIL=
# Number of Azure AI Search chunks (1-20, default: 8).
TEAMS_SEARCH_TOP=8
# Brave Search: auto, always, or off (default: auto).
BRAVE_SUBSCRIPTION_TOKEN=
BRAVE_SEARCH_DEFAULT_ENABLED=true
TEAMS_BRAVE_SEARCH_MODE=auto
TEAMS_BRAVE_SEARCH_TOP=5
# Local development only. This value is ignored in production.
TEAMS_SKIP_AUTH=false

# Salesforce Gateway routing (server-side authorization)
SF_GATEWAY_BASE_URL=https://your-salesforce-gateway.example.com
SF_EXTENSION_ID=
# Comma-separated or newline-separated authenticated user email addresses.
SF_WHITELIST_EMAILS=

# Update your production URL in NEXTAUTH_URL
NEXTAUTH_SECRET=AZURE-OPENIAI-NEXTAUTH-OWNKEY@1
# in production, this should be your production URL e.g. https://azurechat.azurewebsites.net
NEXTAUTH_URL=http://localhost:3000

# Update your Cosmos Environment details here
AZURE_COSMOSDB_URI=https://<cosmoresourcename>.documents.azure.com:443/
AZURE_COSMOSDB_KEY=

# Update your Cosmos variables if you want to overwrite the default values
AZURE_COSMOSDB_DB_NAME=chat
AZURE_COSMOSDB_CONTAINER_NAME=history
AZURE_COSMOSDB_CONFIG_CONTAINER_NAME=config

# Azure AI Search  is used for chat over your data
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_NAME=
AZURE_SEARCH_INDEX_NAME=

# Azure AI Document Intelligence to extract content from your data
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://NAME.api.cognitive.microsoft.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# max upload document size in bytes
MAX_UPLOAD_DOCUMENT_SIZE=20000000

# Azure Speech to Text to convert audio to text
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=

# Azure Storage account to store files
AZURE_STORAGE_ACCOUNT_NAME=azurechat
AZURE_STORAGE_ACCOUNT_KEY=123456

# Azure Key Vault to store secrets
AZURE_KEY_VAULT_NAME=

# Built-in DeskNet's schedule Agent (server-side only)
# Leave DESKNETS_AGENT_API_URL empty to keep the built-in Tool disabled.
DESKNETS_AGENT_ENABLED=false
DESKNETS_AGENT_API_URL=
DESKNETS_AGENT_API_KEY=

# PPT生成 B3（Guarded Creative）モード
# legacy: 現行B2、guarded-creative: B3（配色・レイアウト自由度を拡張）
PPTX_AI_DESIGN_MODE=legacy

# PPT生成 B4（Art Director）モード — B3が有効なときのみ動作
# off: B3のまま（デフォルト）
# audit: Art DirectionとPreflightを実行・記録するが描画へ適用しない
# apply: Phase 2実装完了後に有効化（Phase 1では apply-pending-phase2 としてB3を返す）
PPTX_ART_DIRECTOR_MODE=off
# 連続を許可する同一レイアウトの最大枚数（デフォルト2）
PPTX_ART_DIRECTOR_MAX_LAYOUT_STREAK=2
# B4 apply時に許容するカード系スライドの最大比率（0.2〜0.6、デフォルト0.4）
PPTX_ART_DIRECTOR_MAX_CARD_RATIO=0.4
# B4 apply時に許容するカード系構図の最大連続枚数（1〜3、デフォルト2）
PPTX_ART_DIRECTOR_MAX_CARD_STREAK=2
# B4失敗時にB3成果物へ戻す（初期値true）
PPTX_ART_DIRECTOR_FALLBACK_TO_B3=true
# 完成済みスライドをデッキ全体として再読し、タイトル・役割・重要度だけを補正する
# falseなら従来経路のまま。本文・数値・順番は有効時も変更しない。
PPTX_NARRATIVE_REVIEW_ENABLED=false
# 本文確定前に、指定枚数・主張・根拠・ページ役割をデッキ単位で再設計する
PPTX_STORY_PLANNER_ENABLED=false
# B3 Visionの目標スコア（72=B2相当、90=B3）
PPTX_VISION_TARGET_SCORE=90
# 1スライドあたり最大修正件数（B3のみ）
PPTX_VISION_MAX_FIXES_PER_SLIDE=2
# 再描画後のPass 2検査を有効にする（B3のみ）
PPTX_VISION_SECOND_PASS_ENABLED=false
# 最大Visionパス数（1または2、B3のみ）
PPTX_VISION_MAX_PASSES=2
